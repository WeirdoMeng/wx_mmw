page {
  --surface: #fffdf8;
  --canvas: #f4f7ee;
  --ink: #123d30;
  --muted: #4d6255;
  --accent: #205a40;
  --accent-dark: #123d30;
  --tint: #e5eedd;
  --line: #dce7d8;
  --warm: #ffdfb9;
  --warm-ink: #674328;
  --lime: #ddf28f;
  --danger: #953e3c;
  --danger-bg: #faeae5;
  --success: #205a40;
  --success-bg: #e0efce;
  --field: #f2f6eb;
  --control-border: #91a88e;
  --scrim: rgba(13, 44, 34, .57);
  --gutter: 30rpx;
  --radius: 36rpx;
  --radius-sm: 24rpx;
  --control-size: 96rpx;
  --stage: linear-gradient(132deg, #123d30 10%, #205a40 72%, #30644a);
  --page-wash: radial-gradient(ellipse at 99% 0, #ffedc9 0, transparent 390rpx), linear-gradient(176deg, #ebf4db 0, #f4f7ee 420rpx);
  --lift: 0 8rpx 28rpx rgba(26, 69, 47, .075);

  min-height: 100%;
  color: var(--ink);
  background: var(--canvas);
  background-image: var(--page-wash);
  background-repeat: no-repeat;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans CJK SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.5;
}

page, view, text, button, image, input, textarea, scroll-view {
  box-sizing: border-box;
}

button {
  width: auto;
  min-width: 0;
  padding: 0;
  margin: 0;
  line-height: inherit;
  color: inherit;
  background: transparent;
}

button::after { border: 0; }
button.button-hover { opacity: .78; }
button:focus-visible { outline: 3rpx solid var(--accent); outline-offset: 4rpx; }

.mmw-button {
  display: flex;
  min-width: 0;
  min-height: var(--control-size);
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 13rpx 27rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  color: var(--accent-dark);
  background: var(--tint);
  font-size: 29rpx;
  font-weight: 680;
  line-height: 1.26;
  text-align: center;
  transition: box-shadow 150ms ease, transform 150ms ease, opacity 150ms ease;
}

.mmw-button--primary {
  border-color: #2f654c;
  color: #fff;
  background: linear-gradient(172deg, #2b664a, #1a4c37);
  box-shadow: inset 0 2rpx 0 #ffffff1c, 0 5rpx 0 #103529, 0 10rpx 20rpx #153e3326;
}

.mmw-button--primary image { filter: brightness(0) invert(1); }
.mmw-button--white { border-color: #e0ead6; background: #edf3e4; }
.mmw-button--lime {
  border-color: #d2e383;
  color: var(--ink);
  background: linear-gradient(176deg, #e6f5a8 0, var(--lime) 100%);
  box-shadow: inset 0 2rpx 0 #ffffff88, 0 5rpx 0 #acc95f, 0 10rpx 20rpx #526f2f23;
}

.mmw-button--lime image { filter: none; }
.mmw-button[disabled] { border-color: transparent; color: var(--muted); background: #e5eae0; box-shadow: none; }
.mmw-button[disabled] image { filter: none; opacity: .58; }
.mmw-button.button-hover,
.mmw-button--pressed { box-shadow: none; opacity: .83; transform: translateY(3rpx); }

.mmw-surface {
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  background: var(--surface);
  box-shadow: var(--lift);
}

.mmw-muted { color: var(--muted); font-size: 26rpx; line-height: 1.55; }
.mmw-icon { flex: none; width: 36rpx; height: 36rpx; }

.mmw-mark {
  display: flex;
  flex: none;
  width: 56rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tint);
}

.mmw-mark image { width: 32rpx; height: 32rpx; }

.mmw-safe-bottom {
  padding-bottom: 152rpx;
  padding-bottom: calc(152rpx + env(safe-area-inset-bottom));
}

@media (prefers-reduced-motion: reduce) {
  .mmw-button { transition: none; }
  .mmw-button.button-hover,
  .mmw-button--pressed { transform: none; }
}
