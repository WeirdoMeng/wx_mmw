.tab-island {
  position: fixed;
  z-index: 80;
  right: 24rpx;
  bottom: 12rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  max-width: 740rpx;
  min-height: 116rpx;
  margin: 0 auto;
  padding: 7rpx 9rpx;
  border: 2rpx solid var(--line, #dce7d8);
  border-radius: 999rpx;
  background: var(--surface, #fffdf8);
  box-shadow: 0 8rpx 32rpx #123d3026;
}

.tab-item {
  display: flex;
  flex: 1 1 0;
  min-width: 0;
  width: 100%;
  min-height: 96rpx;
  align-items: center;
  justify-content: center;
  gap: 7rpx;
  margin: 0;
  padding: 3rpx 4rpx;
  border: 0;
  border-radius: 999rpx;
  color: var(--muted, #4d6255);
  background: transparent;
  font-size: 23rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.tab-item::after { border: 0; }
.tab-glyph {
  display: flex;
  width: 38rpx;
  height: 40rpx;
  flex: none;
  align-items: center;
  justify-content: center;
}
.tab-icon { width: 33rpx; height: 33rpx; opacity: .84; }
.tab-item--active { color: var(--ink, #123d30); background: var(--lime, #ddf28f); font-weight: 740; }
.tab-item--active .tab-icon { opacity: 1; }
.tab-item:not(.tab-item--active).tab-item--pressed { background: var(--tint, #e5eedd); }

.tab-island--tools .tab-item {
  width: 0 !important;
  min-height: max(44px, 96rpx);
  flex-direction: column;
  gap: 3rpx;
  margin: 0 !important;
  padding: 8rpx 4rpx;
  border-radius: 34rpx;
  font-size: max(11px, 23rpx);
}

.tab-island--tools .tab-glyph { height: 39rpx; }
