<view class="tab-island {{toolsEnabled ? 'tab-island--tools' : ''}}" wx:if="{{!hidden && role !== 'guest'}}">
  <block wx:for="{{tabs}}" wx:key="id">
    <button wx:if="{{!item.requiresTools || toolsEnabled}}"
      class="tab-item {{selected === item.id ? 'tab-item--active' : ''}}"
      bindtap="select"
      data-id="{{item.id}}"
      hover-class="tab-item--pressed"
      hover-stay-time="{{60}}"
      aria-pressed="{{selected === item.id}}"
      aria-label="{{item.id === 0 && role === 'teacher' ? '作业管理' : item.label}}"
    >
      <view class="tab-glyph">
        <image class="tab-icon" aria-hidden="true" src="/images/ui/{{item.id === 0 && role === 'teacher' ? 'homework' : item.icon}}.png" mode="aspectFit" />
      </view>
      <text>{{item.id === 0 && role === 'teacher' ? '作业管理' : item.label}}</text>
    </button>
  </block>
</view>
