.post-detail {
  max-width: 620px;
  margin: 0 auto;
  padding: 28rpx var(--gutter) 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.post-article {
  position: relative;
  min-height: 210rpx;
  overflow: hidden;
  padding: 28rpx 31rpx 33rpx;
  border-radius: 47rpx 49rpx 20rpx 47rpx;
  isolation: isolate;
  color: #fffdf8;
  background: linear-gradient(124deg, #133d31 10%, #376c50);
  box-shadow: 0 13rpx 30rpx rgba(25, 72, 54, .13);
}

.post-detail--meal .post-article {
  color: #3c2b1e;
  background: linear-gradient(124deg, #ffeed6, var(--warm));
  box-shadow: 0 11rpx 27rpx rgba(109, 69, 34, .10);
}

.post-article::before,
.post-article::after {
  position: absolute;
  z-index: -1;
  right: -78rpx;
  bottom: -170rpx;
  width: 350rpx;
  height: 270rpx;
  transform: rotate(-19deg);
  border: 2rpx solid rgba(221, 242, 143, .34);
  border-radius: 45% 55% 50% 50%;
  content: "";
}

.post-article::after {
  right: -54rpx;
  bottom: -145rpx;
  width: 275rpx;
  height: 218rpx;
}

.post-detail--meal .post-article::before,
.post-detail--meal .post-article::after {
  border-color: rgba(141, 85, 37, .27);
}

.post-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.post-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 13rpx;
  font-size: 13px;
  font-variant-numeric: tabular-nums;
}

.post-actions {
  display: flex;
  flex: none;
  gap: 10rpx;
}

.post-toolbar .post-more {
  display: flex;
  width: auto;
  min-width: 0;
  min-height: 44px;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: 6px;
  margin: 0;
  padding: 0 11px;
  border: 1rpx solid rgba(18, 61, 48, .14);
  border-radius: 999rpx;
  color: var(--ink);
  background: var(--surface);
  font-size: 14px;
  font-weight: 650;
  white-space: nowrap;
}

.post-more image {
  width: 16px;
  height: 16px;
}

.post-tag {
  padding: 6rpx 15rpx;
  border-radius: 999rpx;
  color: #123d30;
  background: var(--lime);
  font-weight: 700;
}

.post-detail--meal .post-tag {
  color: var(--warm-ink);
  background: var(--surface);
}

.detail-title,
.public-title {
  display: block;
  font-size: 31px;
  font-weight: 740;
  line-height: 1.26;
  overflow-wrap: anywhere;
}

.detail-content {
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 33rpx 33rpx 33rpx 16rpx;
  box-shadow: 0 7rpx 27rpx rgba(25, 72, 54, .065);
}

.detail-description {
  display: block;
  color: var(--ink);
  font-size: 16px;
  line-height: 1.72;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.detail-gallery--after-text {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid var(--line);
}

.gallery-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.gallery-title {
  color: var(--ink);
  font-size: 17px;
  font-weight: 730;
}

.post-message,
.post-public {
  display: flex;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  padding: 55rpx 32rpx;
  text-align: center;
}

.public-card {
  display: flex;
  width: 100%;
  max-width: 510px;
  min-height: 360rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 48rpx 24rpx;
  border-radius: 50rpx 50rpx 21rpx 50rpx;
  color: #fffdf8;
  background: radial-gradient(ellipse at 68% 12%, #376e51, #133d31 74%);
}

.public-mark {
  display: grid;
  width: 96rpx;
  height: 96rpx;
  place-items: center;
  border-radius: 40% 57% 47% 52%;
  background: var(--lime);
}

.public-mark image {
  width: 43rpx;
  height: 43rpx;
}

.public-note {
  max-width: 20em;
  color: #ecf1e7;
  line-height: 1.5;
}

.post-muted {
  color: var(--muted);
  font-size: 14px;
  line-height: 1.5;
}

.post-message .post-action {
  width: 142px;
  max-width: 100%;
  min-height: 44px;
  padding: 8px 12px;
  border-radius: 999rpx;
  font-size: 14px;
  text-align: center;
}
