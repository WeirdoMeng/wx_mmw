.tools-page { min-height: 100vh; }

.tools-shell {
  width: 100%;
  max-width: 640px;
  margin: 0 auto;
  padding: 0 var(--gutter) 28rpx;
}

.tools-brand {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 10rpx;
  color: var(--muted);
  font-size: 14px;
  font-weight: 660;
}

.tools-brand image { flex: none; width: 32rpx; height: 32rpx; }
.tools-brand text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.tools-header {
  position: relative;
  isolation: isolate;
  display: flex;
  min-height: 176rpx;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin: 10rpx 0 25rpx;
  overflow: hidden;
  padding: 25rpx 30rpx;
  border-radius: 40rpx;
  background: var(--stage);
  box-shadow: 0 12rpx 28rpx #123d3022;
  color: var(--surface);
}

.tools-header::before {
  position: absolute;
  z-index: -1;
  top: -88rpx;
  right: -48rpx;
  width: 285rpx;
  height: 285rpx;
  border: 30rpx solid #e4f5ba18;
  border-radius: 50%;
  background: #e4f5ba0c;
  content: "";
}

.tools-title {
  min-width: 0;
  font-size: 55rpx;
  font-weight: 750;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.tools-header-symbol {
  display: grid;
  width: 108rpx;
  height: 108rpx;
  flex: none;
  place-items: center;
  border: 2rpx solid #e4f5ba38;
  border-radius: 34rpx;
  background: #e4f5ba1f;
  transform: rotate(-6deg);
}

.tools-header-symbol image { width: 57rpx; height: 57rpx; filter: brightness(0) invert(1); }

.tools-groups { display: grid; gap: 20rpx; }

.tools-group {
  min-width: 0;
  padding: 25rpx 22rpx 21rpx;
}

.tools-group-title {
  display: block;
  margin-bottom: 17rpx;
  padding-inline: 6rpx;
  overflow-wrap: anywhere;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 720;
  line-height: 1.3;
}

.tools-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10rpx 6rpx;
}

.tools-grid .tools-entry {
  display: flex;
  width: 100% !important;
  min-width: 0 !important;
  max-width: 100%;
  min-height: 44px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 11rpx;
  margin: 0 !important;
  padding: 9rpx 2rpx;
  border: 0;
  border-radius: 22rpx;
  background: transparent;
  color: var(--ink);
  font-size: max(12px, 26rpx);
  font-weight: 580;
  line-height: 1.35;
  text-align: center;
  overflow-wrap: anywhere;
}

.tools-grid .tools-entry::after { border: 0; }
.tools-grid .tools-entry--pressed { background: #eef4e8; }

.tools-entry-icon {
  display: grid;
  width: 88rpx;
  max-width: 100%;
  height: 88rpx;
  flex: none;
  place-items: center;
  border: 2rpx solid #29473918;
  border-radius: 27rpx;
  background: #e4efdd;
  box-shadow: inset 0 2rpx 0 #ffffff96;
}

.tools-entry-icon--mint { background: linear-gradient(142deg, #eafaeb, #d5ebdb); }
.tools-entry-icon--sand { background: linear-gradient(142deg, #fff3dc, #f5e7ce); }
.tools-entry-icon--lime { background: linear-gradient(142deg, #f3f8d9, #e5edc6); }
.tools-entry-icon--blue { background: linear-gradient(142deg, #eef5f4, #d9eaea); }
.tools-entry-icon--custom { background: transparent; border-color: transparent; box-shadow: none; }

.tools-entry-icon image { width: 44rpx; height: 44rpx; }
.tools-entry-icon .tools-uploaded-icon { width: 74rpx; height: 74rpx; }

.tools-status {
  display: flex;
  min-height: 114rpx;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 19rpx;
  padding: 21rpx 26rpx;
  color: var(--muted);
  font-size: 14px;
  text-align: center;
}

.tools-status .tools-retry {
  width: auto !important;
  min-height: 44px;
  flex: none;
  margin: 0 !important;
  padding: 8rpx 24rpx;
  font-size: 14px;
}
