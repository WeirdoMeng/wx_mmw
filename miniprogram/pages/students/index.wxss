@import "../profile/fields.wxss";

.students-page {
  min-height: 100vh;
  max-width: 630px;
  margin: 0 auto;
  padding: 22rpx 28rpx 44rpx;
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.students-tools {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  margin-bottom: 21rpx;
  padding: 24rpx 24rpx 19rpx;
  border-radius: 38rpx 38rpx 23rpx 38rpx;
  background: linear-gradient(116deg, #d9ebca 10%, #e9f1d9 82%);
}

.students-tools::before {
  position: absolute;
  z-index: -1;
  right: -88rpx;
  bottom: -166rpx;
  width: 425rpx;
  height: 280rpx;
  border: 3rpx solid rgba(36, 98, 56, .17);
  border-radius: 47% 53% 60% 40%;
  content: '';
  pointer-events: none;
  transform: rotate(-25deg);
}

.student-search {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 96rpx;
  padding: 7rpx 20rpx 7rpx 10rpx;
  border: 2rpx solid transparent;
  border-radius: 60rpx;
  background: var(--surface);
  box-shadow: 0 5rpx 14rpx rgba(18, 61, 48, .07);
}

.student-search:focus-within {
  border-color: var(--accent);
}

.student-search-icon {
  display: grid;
  flex: 0 0 65rpx;
  place-items: center;
  width: 65rpx;
  height: 65rpx;
  border-radius: 50%;
  background: var(--tint);
}

.student-search-icon image {
  width: 31rpx;
  height: 31rpx;
}

.student-search input {
  flex: 1;
  min-width: 0;
  min-height: 50px;
  color: var(--ink);
  font-size: 30rpx;
}

.students-count {
  display: block;
  margin: 13rpx 12rpx 0;
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 650;
}

.manager-card {
  position: relative;
  overflow: hidden;
  margin: 0 0 16rpx;
  padding: 22rpx 22rpx 23rpx;
  border-radius: 33rpx 33rpx 22rpx 33rpx;
  background: var(--surface);
  box-shadow: 0 9rpx 18rpx rgba(18, 61, 48, .06);
}

.manager-person {
  display: flex;
  align-items: center;
  gap: 19rpx;
  padding: 2rpx 2rpx 16rpx;
}

.manager-avatar {
  display: grid;
  flex: 0 0 84rpx;
  place-items: center;
  width: 84rpx;
  height: 84rpx;
  border-radius: 32% 44% 45% 35%;
  color: var(--ink);
  background: var(--tint);
  font-size: 36rpx;
  font-weight: 770;
}

.manager-card--alternate .manager-avatar {
  background: var(--warm);
}

.manager-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 3rpx;
  min-width: 0;
}

.manager-name {
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.manager-grade {
  color: var(--muted);
  font-size: 25rpx;
  overflow-wrap: anywhere;
}

.manager-actions {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding-top: 9rpx;
}

.manager-actions .manager-button {
  flex: .86 1 0;
  width: 0;
  min-width: 0;
  min-height: 44px;
  margin: 0;
  padding: 11rpx 5rpx;
  border-radius: 52rpx;
  font-size: 26rpx;
  line-height: 1.25;
  word-break: keep-all;
}

.manager-actions .manager-button--contact {
  flex: 1.34 1 0;
  gap: 7rpx;
  color: var(--ink);
  background: var(--tint);
}

.manager-button--contact image {
  flex: none;
  width: 26rpx;
  height: 26rpx;
}

.students-message {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 34rpx 16rpx;
  border-radius: 28rpx;
  color: var(--muted);
  background: var(--surface);
  font-size: 28rpx;
  text-align: center;
  overflow-wrap: anywhere;
}

.students-message .manager-button {
  width: auto;
  min-width: 128rpx;
}

.students-pagination {
  display: grid;
  gap: 12rpx;
  justify-items: center;
  margin: 18rpx 0;
}

.student-sheet-scroll--parents {
  height: 180rpx;
  max-height: 56vh;
}

.student-sheet-scroll--parents.parents-scroll--one {
  height: 500rpx;
}

.student-sheet-scroll--parents.parents-scroll--multiple {
  height: 56vh;
}

.contact-summary {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8rpx 16rpx;
  margin-bottom: 20rpx;
}

.contact-summary .mmw-muted {
  padding: 5rpx 13rpx;
  border-radius: 30rpx;
  color: var(--ink);
  background: var(--warm);
  font-size: 24rpx;
}

.contact-student {
  min-width: 0;
  color: var(--ink);
  font-size: 34rpx;
  font-weight: 750;
  overflow-wrap: anywhere;
}

.contact-group {
  overflow: hidden;
  border-radius: 25rpx;
  background: var(--field);
}

.contact-group + .contact-group {
  margin-top: 15rpx;
}

.contact-heading,
.contact-empty {
  display: block;
  padding: 15rpx 20rpx;
  overflow-wrap: anywhere;
}

.contact-heading {
  color: var(--ink);
  background: var(--tint);
  font-size: 29rpx;
  font-weight: 710;
}

.contact-empty,
.contact-value {
  color: var(--muted);
  font-size: 26rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 13rpx;
  min-height: 73rpx;
  padding: 5rpx 20rpx;
  color: var(--ink);
  font-size: 26rpx;
}

.contact-row + .contact-row {
  border-top: 1rpx solid var(--line);
}

.contact-value {
  max-width: 62%;
  text-align: right;
  overflow-wrap: anywhere;
}

.contact-row--phone > text { flex: none; }
.contact-phone {
  display: flex;
  min-width: 0;
  align-items: center;
  justify-content: flex-end;
  gap: 5px;
}
.contact-phone .contact-value { min-width: 0; max-width: none; font-variant-numeric: tabular-nums; }
.contact-phone .contact-call {
  display: flex;
  flex: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: var(--tint);
}
.contact-call image { width: 19px; height: 19px; }

