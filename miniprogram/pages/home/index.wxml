<mmw-share-cover wx:if="{{shareRecord}}" record="{{shareRecord}}" bind:ready="onShareCoverReady" />
<view class="home-page">
  <view class="home-content" style="padding-top: {{headerInset}}px;">
    <view class="home-hero">
      <view class="hero-content">
        <text class="hero-brand">{{organizationName || '托管中心'}}</text>
        <view class="hero-title">{{staff ? '作业管理' : '我的孩子'}}</view>
        <view wx:if="{{!staff && !sessionLoading && student && students.length < 2}}" class="hero-meta">
          <text>{{student.name}}</text><text wx:if="{{student.grade}}"> · {{student.grade}}</text>
        </view>
      </view>
      <view class="hero-picture" aria-hidden="true">
        <image class="hero-art" src="/images/brand/after-school.png" mode="aspectFit" />
      </view>
    </view>
    <view wx:if="{{sessionLoading}}" class="mmw-surface home-message"><text>正在加载…</text></view>
    <view wx:elif="{{sessionError}}" class="mmw-surface home-message home-message--error">
      <text>{{sessionError}}</text><button class="retry-action" bindtap="loadSession">重试</button>
    </view>
    <block wx:else>
      <button wx:if="{{staff || students.length > 1}}" class="student-select" disabled="{{saving || picking || submitting}}" bindtap="openStudentSheet" aria-label="{{student ? '切换' + (staff ? '学生' : '孩子') + '，当前为' + student.name : '选择学生'}}">
        <view class="mmw-mark"><image src="{{staff ? '/images/ui/people.png' : '/images/ui/child.png'}}" mode="aspectFit" aria-hidden="true" /></view>
        <view class="student-select__label"><text>{{student ? student.name : '选择学生'}}</text><text wx:if="{{student && student.grade}}" class="home-muted">{{student.grade}}</text></view>
        <text wx:if="{{!staff}}" class="home-muted">切换孩子</text>
        <image class="student-select__icon" src="/images/ui/expand.png" mode="aspectFit" aria-hidden="true" />
      </button>
      <view wx:if="{{!student}}" class="mmw-surface home-message">
        <image class="home-icon" src="/images/ui/people.png" mode="aspectFit" aria-hidden="true" /><text>从学生列表选择一名学生</text>
      </view>
      <block wx:else>
        <view class="home-planner">
          <mmw-calendar value="{{date}}" marked-dates="{{markedDates}}" feedback-dates="{{feedbackDates}}"
            disabled="{{saving || picking || submitting}}" bind:change="calendarChanged" />
          <view wx:if="{{!staff}}" class="planner-actions">
            <view class="home-section-head"><text class="planner-label">当天作业</text><text class="home-muted">{{dateLabel}}</text></view>
            <view class="home-pair">
              <button class="mmw-button mmw-button--lime home-control" bindtap="openUploadSheet">
                <image class="home-icon" src="/images/ui/upload.png" mode="aspectFit" aria-hidden="true" /><text>上传作业</text>
              </button>
              <button class="mmw-button mmw-button--white home-control" bindtap="openWork">
                <image class="home-icon" src="/images/ui/document.png" mode="aspectFit" aria-hidden="true" /><text>查看作业</text>
              </button>
            </view>
          </view>
          <view wx:else class="planner-actions">
            <button class="mmw-button mmw-button--white home-control planner-view" disabled="{{saving || picking}}" bindtap="openWork">
              <view class="planner-icon"><image class="home-icon" src="/images/ui/document.png" mode="aspectFit" aria-hidden="true" /></view>
              <text>查看当天作业</text>
              <image class="planner-arrow" src="/images/ui/next.png" mode="aspectFit" aria-hidden="true" />
            </button>
          </view>
        </view>

        <view class="home-section">
          <view class="home-section-head">
            <view class="home-section-title">
              <view class="section-icon"><image src="/images/ui/message.png" mode="aspectFit" aria-hidden="true" /></view>
              <text class="home-heading">{{staff ? '完成反馈' : '老师反馈'}}</text>
            </view>
            <text wx:if="{{staff}}" class="home-muted">{{dateLabel}}</text>
          </view>
          <view wx:if="{{dayLoading}}" class="mmw-surface home-message"><text>正在加载当天记录…</text></view>
          <view wx:elif="{{dayError}}" class="mmw-surface home-message home-message--error">
            <text>{{dayError}}</text><button class="retry-action" bindtap="loadSession">重试</button>
          </view>
          <block wx:elif="{{staff}}">
            <view class="mmw-surface teacher-form">
              <view class="home-pair" aria-label="整体完成情况">
                <button class="feedback-option {{editorStatus === 'pending' ? 'feedback-option--pending' : ''}}" disabled="{{saving || picking}}" aria-pressed="{{editorStatus === 'pending'}}" data-status="pending" bindtap="changeStatus">未完成</button>
                <button class="feedback-option {{editorStatus === 'done' ? 'feedback-option--done' : ''}}" disabled="{{saving || picking}}" aria-pressed="{{editorStatus === 'done'}}" data-status="done" bindtap="changeStatus">已完成</button>
              </view>
              <view class="upload-label">学习情况</view>
              <textarea class="home-field teacher-note" value="{{editorNote}}" maxlength="1800" disabled="{{saving}}" bindinput="changeEditorNote" placeholder="写下当天的学习情况" aria-label="学习情况" />
              <view class="attachment-area">
                <text class="attachment-count">照片 {{editorPhotos.length}} / {{maxPhotos}}</text>
                <mmw-photos items="{{editorPhotos}}" editable retryable disabled="{{saving || picking}}"
                  data-kind="editor" bind:add="addPhotos" bind:remove="removePhoto" bind:preview="previewPhoto" />
              </view>
              <view class="home-pair">
                <button class="mmw-button mmw-button--primary home-control" loading="{{saving}}" disabled="{{saving || picking}}" bindtap="submitFeedback">
                  <image wx:if="{{!saving}}" class="home-icon" src="{{hasSavedFeedback ? '/images/ui/save.png' : '/images/ui/send.png'}}" mode="aspectFit" aria-hidden="true" /><text>{{hasSavedFeedback ? '保存修改' : '提交反馈'}}</text>
                </button>
                <button wx:if="{{hasSavedFeedback}}" class="mmw-button mmw-button--white home-control" open-type="share" data-share="feedback" disabled="{{saving || picking}}">
                  <image class="home-icon" src="/images/ui/share.png" mode="aspectFit" /><text>分享到聊天</text>
                </button>
              </view>
            </view>
          </block>
          <button wx:elif="{{feedbackPreview}}" class="mmw-surface preview-card" bindtap="openFeedback" aria-label="查看反馈详情">
            <view class="preview-heading">
              <view class="preview-copy">
                <view class="home-badge {{feedbackPreview.status === 'done' ? '' : 'home-badge--pending'}}">
                  <image wx:if="{{feedbackPreview.status === 'done'}}" src="/images/ui/check.png" mode="aspectFit" />
                  <text>{{feedbackPreview.status === 'done' ? '已完成' : '未完成'}}</text>
                </view>
                <text wx:if="{{feedbackPreview.note}}" class="preview-note">{{feedbackPreview.note}}</text>
                <text class="preview-link">查看反馈{{feedbackPreview.count ? ' · ' + feedbackPreview.count + ' 张照片' : ''}}</text>
              </view>
              <image class="preview-arrow" src="/images/ui/next.png" mode="aspectFit" />
            </view>
            <mmw-photos wx:if="{{feedbackPreview.photos.length}}" items="{{feedbackPreview.photos}}" passive />
          </button>
          <view wx:else class="mmw-surface home-message">
            <image class="home-icon" src="/images/ui/message.png" mode="aspectFit" /><text>当天暂无老师反馈</text>
          </view>
        </view>
      </block>
    </block>
  </view>
  <view class="home-bottom-space" />

  <view wx:if="{{sheet}}" class="home-overlay">
    <view class="home-overlay__mask" bindtap="closeSheet" catchtouchmove="preventBubble" />
    <view class="home-sheet">
      <view class="sheet-header">
        <text class="sheet-title">{{sheet === 'students' ? (staff ? '选择学生' : '切换孩子') : '上传作业'}}</text>
        <button class="sheet-close" disabled="{{submitting || picking}}" bindtap="closeSheet" aria-label="关闭">
          <image src="/images/ui/close.png" mode="aspectFit" />
        </button>
      </view>
      <block wx:if="{{sheet === 'students'}}">
        <view wx:if="{{staff}}" class="sheet-search">
          <image class="home-icon" src="/images/ui/search.png" mode="aspectFit" />
          <input value="{{studentQuery}}" bindinput="filterStudents" placeholder="输入学生姓名" confirm-type="search" maxlength="60" />
        </view>
        <scroll-view class="student-list" scroll-y enhanced show-scrollbar="{{false}}">
          <button wx:for="{{filteredStudents}}" wx:key="id" class="student-row" hover-class="student-row--emphasis" data-id="{{item.id}}" bindtap="selectStudent">
            <text class="student-row__name">{{item.name}}</text>
            <text wx:if="{{item.grade}}" class="home-muted">{{item.grade}}</text>
            <image class="student-row__arrow" src="{{student && student.id === item.id ? '/images/ui/check.png' : '/images/ui/next.png'}}" mode="aspectFit" />
          </button>
          <view wx:if="{{studentListLoading && !filteredStudents.length}}" class="sheet-empty">正在加载名单</view>
          <view wx:elif="{{!studentListError && !filteredStudents.length}}" class="sheet-empty">{{studentQuery ? '没有找到学生' : '学生列表为空'}}</view>
          <view wx:if="{{studentListHasMore || studentListError}}" class="sheet-pagination">
            <text wx:if="{{studentListError}}" class="sheet-error">{{studentListError}}</text>
            <button class="mmw-button mmw-button--white" disabled="{{studentListLoading}}" loading="{{studentListLoading}}" bindtap="loadMoreStudents">
              {{studentListError ? '重试' : '加载更多'}}
            </button>
          </view>
        </scroll-view>
      </block>
      <block wx:else>
        <text class="sheet-date">{{student.name}} · {{dateLabel}}</text>
        <view class="upload-label">作业内容</view>
        <textarea class="home-field upload-field" value="{{uploadNote}}" maxlength="1000" disabled="{{submitting}}" bindinput="changeUploadNote" placeholder="输入作业说明" aria-label="作业说明" />
        <view class="attachment-area">
          <text class="attachment-count">照片 {{uploadPhotos.length}} / {{maxPhotos}}</text>
          <mmw-photos items="{{uploadPhotos}}" editable disabled="{{submitting || picking}}"
            data-kind="upload" bind:add="addPhotos" bind:remove="removePhoto" bind:preview="previewPhoto" />
        </view>
        <view wx:if="{{uploadError}}" class="sheet-error" aria-live="polite">{{uploadError}}</view>
        <button class="mmw-button mmw-button--primary home-control sheet-submit" loading="{{submitting}}" disabled="{{submitting || picking}}" bindtap="submitAssignment">上传到所选日期</button>
      </block>
    </view>
  </view>
</view>
