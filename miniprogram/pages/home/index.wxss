.home-page { min-height: 100vh; background-image: var(--page-wash); }
.home-content { max-width: 960rpx; margin: 0 auto; padding-inline: var(--gutter); }
.home-hero {
  position: relative;
  isolation: isolate;
  display: flex;
  min-height: 242rpx;
  overflow: hidden;
  align-items: center;
  margin: 6rpx 0 22rpx;
  padding: 26rpx 30rpx 30rpx;
  border-radius: 46rpx 46rpx 46rpx 16rpx;
  color: var(--surface);
  background: var(--stage);
  box-shadow: 0 15rpx 30rpx #123d3024;
}
.hero-content { position: relative; z-index: 1; width: 67%; min-width: 0; }
.hero-brand { display: block; color: var(--lime); font-size: 25rpx; font-weight: 650; overflow-wrap: anywhere; }
.hero-title { margin-top: 7rpx; font-size: 64rpx; font-weight: 780; line-height: 1.1; }
.hero-meta { margin-top: 12rpx; color: #e3efd9; font-size: 28rpx; overflow-wrap: anywhere; }
.hero-picture {
  position: absolute;
  right: 8rpx;
  bottom: 0;
  width: 37%;
  height: 100%;
  min-width: 185rpx;
  max-width: 290rpx;
  pointer-events: none;
}
.hero-picture::before,
.hero-picture::after { position: absolute; border-radius: 50%; content: ''; }
.hero-picture::before {
  right: -30rpx;
  bottom: -105rpx;
  width: 280rpx;
  height: 280rpx;
  border: 24rpx solid #d1e98432;
  background: #b9d67b16;
}
.hero-picture::after { top: 31rpx; right: 30rpx; width: 26rpx; height: 26rpx; background: var(--warm); }
.hero-art { position: absolute; right: 4rpx; bottom: 6rpx; z-index: 1; width: 94%; height: 94%; }

.home-page .student-select {
  display: flex;
  width: 100%;
  min-height: 100rpx;
  align-items: center;
  gap: 16rpx;
  margin: 0 0 18rpx;
  padding: 13rpx 23rpx;
  border: 2rpx solid #edf0e2;
  border-radius: 32rpx;
  background: var(--surface);
  box-shadow: var(--lift);
  text-align: left;
}
.student-select__label { display: flex; min-width: 0; flex: 1; flex-direction: column; gap: 2rpx; font-size: 30rpx; font-weight: 650; overflow-wrap: anywhere; }
.student-select__label .home-muted { font-weight: 500; }
.student-select__icon { flex: none; width: 30rpx; height: 30rpx; }
.home-planner {
  padding: 10rpx 12rpx 14rpx;
  border: 2rpx solid #e8ecdc;
  border-radius: 40rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 30rpx #204f3713;
}
.planner-actions { margin: 0 6rpx; padding: 0 6rpx 12rpx; }
.planner-label { font-size: 28rpx; font-weight: 720; }
.home-page .planner-view { justify-content: flex-start; gap: 14rpx; padding: 8rpx 16rpx 8rpx 9rpx; }
.planner-icon { display: flex; width: 66rpx; height: 66rpx; align-items: center; justify-content: center; border-radius: 50%; background: #dceaca; }
.planner-arrow { width: 30rpx; height: 30rpx; margin-left: auto; }
.home-section { margin-top: 28rpx; }
.home-section-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6rpx 14rpx; margin: 0 3rpx 14rpx; }
.home-section-title { display: flex; align-items: center; gap: 12rpx; }
.section-icon { display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border-radius: 50%; background: var(--warm); }
.section-icon image { width: 30rpx; height: 30rpx; }
.home-heading { font-size: 34rpx; font-weight: 740; line-height: 1.3; }
.home-muted { color: var(--muted); font-size: 25rpx; line-height: 1.5; }
.home-pair { display: flex; gap: 16rpx; }
.home-pair > button { flex: 1 1 0; min-width: 0; }
.home-page .home-control { width: 100%; }
.home-icon { display: block; flex: none; width: 34rpx; height: 34rpx; }
.home-message {
  display: flex;
  min-height: 108rpx;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  color: var(--muted);
  font-size: 28rpx;
  overflow-wrap: anywhere;
}
.home-message--error { justify-content: space-between; border-color: #eed5cf; color: var(--danger); }
.home-message--error > text { flex: 1; min-width: 0; }
.home-page .retry-action {
  flex: 0 0 auto;
  min-width: 90rpx;
  min-height: 88rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  color: var(--accent-dark);
  background: var(--tint);
  font-size: 26rpx;
  font-weight: 650;
}
.home-page .preview-card {
  display: flex;
  width: 100%;
  min-height: 126rpx;
  flex-direction: column;
  align-items: stretch;
  gap: 16rpx;
  padding: 22rpx;
  border-color: #dce9ce;
  background: linear-gradient(98deg, #eff7e3 0, #fffdf8 54%);
  text-align: left;
}
.preview-heading { display: flex; align-items: center; gap: 16rpx; }
.preview-copy { display: flex; min-width: 0; flex: 1; flex-direction: column; align-items: flex-start; gap: 10rpx; }
.home-badge {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  gap: 7rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: var(--success);
  background: var(--success-bg);
  font-size: 24rpx;
  font-weight: 680;
  white-space: nowrap;
}
.home-badge--pending { color: var(--warm-ink); background: var(--warm); }
.home-badge image { width: 22rpx; height: 22rpx; }
.preview-note { display: -webkit-box; overflow: hidden; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow-wrap: anywhere; font-size: 29rpx; }
.preview-link { color: var(--accent-dark); font-size: 24rpx; font-weight: 620; }
.preview-arrow { flex: none; width: 28rpx; height: 28rpx; }
.teacher-form { padding: 24rpx; border-color: #e8ecdc; }
.home-page .feedback-option {
  display: flex;
  min-height: 88rpx;
  justify-content: center;
  align-items: center;
  padding: 10rpx 12rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  color: var(--ink);
  background: #edf2e9;
  font-size: 28rpx;
  font-weight: 600;
}
.home-page .feedback-option--pending { border-color: #eaca9f; color: var(--warm-ink); background: var(--warm); font-weight: 720; }
.home-page .feedback-option--done { border-color: #bccf89; color: var(--accent-dark); background: var(--lime); font-weight: 720; }
.home-page .feedback-option[disabled] { opacity: .65; }
.home-field {
  display: block;
  width: 100%;
  min-height: 152rpx;
  padding: 18rpx 20rpx;
  border: 2rpx solid var(--line);
  border-radius: 20rpx;
  color: var(--ink);
  background: var(--field);
  font-size: 30rpx;
  line-height: 1.5;
}
.teacher-note { height: 172rpx; }
.attachment-area { margin: 18rpx 0 24rpx; }
.attachment-count { display: block; margin-bottom: 10rpx; color: var(--muted); font-size: 25rpx; }
.home-bottom-space { height: 152rpx; height: calc(152rpx + env(safe-area-inset-bottom)); }
.home-overlay { position: fixed; inset: 0; z-index: 100; }
.home-overlay__mask { position: absolute; inset: 0; background: var(--scrim); }
.home-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  max-height: 88vh;
  overflow-y: auto;
  padding: 23rpx var(--gutter) 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 44rpx 44rpx 0 0;
  background: var(--surface);
  box-shadow: 0 -14rpx 40rpx #19392a28;
}
.sheet-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-bottom: 16rpx; }
.sheet-title { flex: 1 1 auto; min-width: 0; font-size: 38rpx; font-weight: 740; }
.home-page .sheet-close {
  display: flex;
  flex: 0 0 88rpx;
  width: 88rpx;
  min-width: 88rpx;
  max-width: 88rpx;
  height: 88rpx;
  margin: 0 0 0 auto;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--tint);
  line-height: 1;
}
.sheet-close image { width: 33rpx; height: 33rpx; }
.sheet-date, .sheet-empty { color: var(--muted); font-size: 28rpx; line-height: 1.5; }
.sheet-search { display: flex; min-height: 100rpx; align-items: center; gap: 14rpx; padding: 8rpx 26rpx; border: 2rpx solid var(--line); border-radius: 999rpx; background: var(--field); }
.sheet-search input { min-width: 0; min-height: 76rpx; flex: 1; font-size: 30rpx; }
.student-list { height: 45vh; max-height: 580rpx; margin-top: 14rpx; }
.home-page .student-row { display: flex; width: 100%; min-height: 96rpx; align-items: center; gap: 16rpx; padding: 8rpx; border-bottom: 2rpx solid var(--line); border-radius: 0; }
.home-page .student-row--emphasis { background: var(--tint); }
.student-row__name { flex: 1; min-width: 0; font-size: 30rpx; font-weight: 650; text-align: left; overflow-wrap: anywhere; }
.student-row__arrow { flex: none; width: 30rpx; height: 30rpx; }
.sheet-empty { padding: 24rpx 8rpx; }
.sheet-pagination { display: grid; gap: 10rpx; justify-items: center; padding: 14rpx 8rpx; }
.upload-label { margin: 16rpx 0 9rpx; font-size: 29rpx; font-weight: 650; }
.upload-field { height: 186rpx; }
.sheet-error { margin: 0 0 14rpx; color: var(--danger); font-size: 28rpx; overflow-wrap: anywhere; }
