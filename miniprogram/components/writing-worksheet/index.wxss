:host { display: block; min-width: 0; }

.writing { display: grid; gap: 14px; color: var(--ink); font-size: 14px; }

.writing-card {
  display: grid;
  min-width: 0;
  gap: 14px;
  padding: 15px;
  border: 1px solid var(--line);
  border-radius: 20px;
  background: var(--surface);
  box-shadow: var(--lift);
}

.writing-field { display: grid; min-width: 0; gap: 6px; }
.writing-field-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; }
.writing-label { font-weight: 680; }
.writing-muted { color: var(--muted); font-size: 13px; font-weight: 500; }
.writing-label .writing-muted { margin-left: 5px; }
.writing-title { font-size: 18px; font-weight: 730; }

.writing-grids, .writing-strokes, .writing-columns, .writing-example-grid {
  display: grid;
  min-width: 0;
  gap: 7px;
}
.writing-columns, .writing-example-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.writing-grids { grid-template-columns: repeat(3, minmax(0, 1fr)); }
.writing-strokes { grid-template-columns: repeat(4, minmax(0, 1fr)); }

.writing .writing-button {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 44px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  margin: 0;
  padding: 6px 5px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--field);
  font-size: 14px;
  line-height: 1.25;
}
.writing .writing-button::after { border: 0; }
.writing .writing-button--selected {
  border-color: var(--accent-dark);
  background: var(--accent);
  color: var(--surface);
  box-shadow: inset 0 0 0 1px #ffffff36;
  font-weight: 700;
}
.writing-selection-mark {
  display: grid;
  width: 15px;
  height: 15px;
  flex: none;
  place-items: center;
  border-radius: 50%;
  background: var(--lime);
  visibility: hidden;
}
.writing-selection-mark image { width: 11px; height: 11px; }
.writing-button--selected .writing-selection-mark { visibility: visible; }
.writing .writing-stroke-choice {
  position: relative;
  min-height: 72px;
  flex-direction: column;
  padding: 18px 4px 6px;
  font-size: 13px;
}
.writing-stroke-illustration { width: 26px; height: 26px; flex: none; }
.writing-button--selected .writing-stroke-illustration { filter: brightness(0) invert(1); }
.writing-stroke-choice .writing-selection-mark { position: absolute; top: 4px; right: 4px; }
.writing-stroke-choice text { overflow-wrap: anywhere; }
.writing-stroke-group { display: grid; min-width: 0; gap: 4px; border-bottom: 1px solid var(--line); }
.writing-stroke-group .writing-strokes { padding-bottom: 9px; }
.writing-group-count { display: flex; align-items: center; gap: 8px; }
.writing .writing-primary { border-color: var(--accent); background: var(--accent); color: #fff; font-weight: 700; }
.writing .writing-export { border-color: var(--control-border); color: var(--accent-dark); font-weight: 700; }
.writing .writing-button[disabled] { opacity: .56; }
.writing-disclosure { border-block: 1px solid var(--line); }
.writing .writing-toggle { padding-inline: 4px; justify-content: space-between; border: 0; background: transparent; font-weight: 650; }
.writing-toggle image, .writing-select image { width: 16px; height: 16px; flex: none; }
.writing-example-grid, .writing-options { padding: 4px 0 10px; }
.writing-options { display: grid; gap: 7px; }
.writing-option {
  display: flex;
  min-height: 44px;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-inline: 4px;
}

.writing-input {
  width: 100%;
  min-width: 0;
  min-height: 44px;
  padding: 8px 10px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: var(--field);
  color: var(--ink);
}
.writing-input input, input.writing-input { height: 44px; }
.writing-text { height: 92px; box-sizing: border-box; line-height: 1.45; }
.writing-select { display: flex; align-items: center; justify-content: space-between; gap: 6px; }
.writing-error { color: var(--danger); }

